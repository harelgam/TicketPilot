# Copy to .env and fill in. Never commit the populated file.
# Variable names only below — no values.

# Required for the real provider. Not needed for tests or --offline runs.
ANTHROPIC_API_KEY=

# Optional. Defaults are applied in src/ticketpilot/config.py when unset.
ANTHROPIC_MODEL=
TICKETPILOT_PROVIDER=
TICKETPILOT_EFFORT=
TICKETPILOT_CONFIDENCE_THRESHOLD=
TICKETPILOT_MAX_TOKENS=
TICKETPILOT_TIMEOUT_SECONDS=
